# Copy to .env (never commit .env)
# 1 = fake data everywhere (frontend work). 0 = real scoring, progress and levels (no GPU needed);
# audio scoring and stories then need the AMD droplet.
MOCK_MODE=1
API_BASE_URL=http://localhost:8000

# AMD droplet / vLLM (role 1 fills these in)
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_API_KEY=change-me
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct

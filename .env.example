# Copy to .env (never commit .env)
# 1 = fake game data (no model, no LLM). 0 = real scoring, progress and levels (no GPU needed);
# audio scoring then needs the speech packages (backend/requirements-speech.txt), stories an LLM endpoint.
MOCK_MODE=1
# Our Arabic phoneme model: a local folder or a Hugging Face repo id (default: ml/models/arabic-phoneme)
# ARABIC_SPEECH_MODEL=
API_BASE_URL=http://localhost:8000

# LLM for the coach and stories. With ANTHROPIC_API_KEY set, Claude is used (LLM_MODEL overrides the default
# claude-opus-5-5); otherwise the OpenAI-compatible endpoint below. Set a spending limit at the provider.
# ANTHROPIC_API_KEY=
# LLM_MODEL=
# Or any OpenAI-compatible endpoint (names are historical)
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_API_KEY=change-me
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
